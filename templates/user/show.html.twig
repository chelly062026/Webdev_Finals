{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}

<style>
    /* Page Wrapper */
    .page-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 32px;
        width: 100%;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
    }

    /* Detail Card */
    .detail-card {
        background: #ffffff;
        width: 100%;
        max-width: 600px;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        margin: 0 auto;
    }

    .detail-card h1 {
        text-align: center;
        margin-bottom: 25px;
        color: #333;
    }

    /* Table */
    .detail-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
    }

    .detail-table th {
        text-align: left;
        padding: 12px;
        width: 35%;
        background: #f4f6f9;
        color: #555;
        font-weight: 600;
    }

    .detail-table td {
        padding: 12px;
        color: #333;
        border-bottom: 1px solid #eee;
    }

    /* Actions */
    .actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 20px;
        justify-content: space-between;
        align-items: center;
    }

    .btn-primary {
        padding: 10px 18px;
        border-radius: 8px;
        background: #92278f;
        color: #fff;
        text-decoration: none;
        font-size: 14px;
    }

    .btn-primary:hover {
        background: #b344a1;
    }

    .btn-secondary {
        text-decoration: none;
        color: #555;
        font-size: 14px;
        border: 1px solid #ccc;
        padding: 8px 12px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .btn-secondary:hover {
        color: #fff;
        background: #92278f;
        border-color: #92278f;
    }

    .btn-danger {
        padding: 10px 18px;
        border-radius: 8px;
        border: none;
        background: #dc3545;
        color: #fff;
        cursor: pointer;
        transition: background 0.3s ease;
    }

    .btn-danger:hover {
        background: #b52a37;
    }
</style>

<div class="page-wrapper">
    <div class="detail-card">
        <h1>User Details</h1>

        <table class="detail-table">
            <tbody>
                <tr>
                    <th>ID</th>
                    <td>{{ user.id }}</td>
                </tr>
                <tr>
                    <th>Username</th>
                    <td>{{ user.username }}</td>
                </tr>
                <tr>
                    <th>Roles</th>
                    <td>{{ user.roles|join(', ') }}</td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td>{% if user.enabled %}<span class="badge bg-success">Active</span>{% else %}<span class="badge bg-secondary">Disabled</span>{% endif %}</td>
                </tr>
            </tbody>
        </table>

        <div class="actions">
            <a class="btn-secondary" href="{{ path('app_user_index') }}">
                ← Back to list
            </a>

            <a class="btn-primary" href="{{ path('app_user_edit', {'id': user.id}) }}">
                Edit
            </a>

            <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Are you sure you want to delete this user?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                <button class="btn-danger">Delete</button>
            </form>
        </div>
    </div>
</div>

{% endblock %}
