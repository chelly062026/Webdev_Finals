{% extends 'shop/layout.html.twig' %}

{% block title %}My Orders - Chelswear{% endblock %}

{% block shop_stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/checkout.css') }}">
{% endblock %}

{% block shop_body %}
<div class="shop-page">
    <header class="shop-page-header">
        <h1>My Orders</h1>
        <p>Track your past purchases.</p>
    </header>

    <div id="live-orders-history-container">
        {% if orders|length > 0 %}
            <div class="my-orders-list">
                {% for order in orders %}
                    <article class="my-order-card">
                        <div class="my-order-head">
                            <span class="my-order-id">Order #{{ order.id }}</span>
                            <span class="my-order-status status-{{ order.status }}">{{ order.status|capitalize }}</span>
                        </div>
                        <p class="my-order-date">{{ order.createdAt|date('M d, Y g:i A') }}</p>
                        <p class="my-order-desc">{{ order.description|slice(0, 120) }}{% if order.description|length > 120 %}...{% endif %}</p>
                        <div class="my-order-foot">
                            <strong>₱{{ order.totalAmount|number_format(2, '.', ',') }}</strong>
                            <a href="{{ path('app_my_order_show', {id: order.id}) }}" class="btn-shop-view">Details</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="shop-empty">
                <p>You have not placed any orders yet.</p>
                <a href="{{ path('app_shop') }}" class="btn-shop-cart">Start Shopping</a>
            </div>
        {% endif %}
    </div>
</div>

<script>
    function refreshOrderHistory() {
        fetch(window.location.href)
            .then(response => response.text())
            .then(htmlString => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(htmlString, 'text/html');
                const incoming = doc.getElementById('live-orders-history-container');
                const current = document.getElementById('live-orders-history-container');
                if (incoming && current && incoming.innerHTML.trim() !== current.innerHTML.trim()) {
                    current.innerHTML = incoming.innerHTML;
                }
            })
            .catch(err => console.warn("History sync missed", err));
    }

    // Check every 5 seconds
    setInterval(refreshOrderHistory, 5000);

    // WebSocket Turbo
    const SOCKET_URL = 'ws://localhost:8080';
    let socket;
    function connectWS() {
        socket = new WebSocket(SOCKET_URL);
        socket.onmessage = (e) => {
            const data = JSON.parse(e.data);
            if (data.type === 'order.updated' || data.type === 'order.created') refreshOrderHistory();
        };
        socket.onclose = () => setTimeout(connectWS, 5000);
    }
    connectWS();
</script>
{% endblock %}
