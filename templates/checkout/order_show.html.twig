{% extends 'shop/layout.html.twig' %}

{% block title %}Order #{{ order.id }} - Chelswear{% endblock %}

{% block shop_stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/checkout.css') }}">
{% endblock %}

{% block shop_body %}
<div class="shop-page">
    <a href="{{ path('app_my_orders') }}" class="shop-back-link">&larr; My Orders</a>

    <div id="live-customer-order-detail-container" class="checkout-order-detail">
        <header class="shop-page-header">
            <h1>Order #{{ order.id }}</h1>
            <p>Placed on {{ order.createdAt|date('F d, Y \\a\\t g:i A') }}</p>
        </header>

        <dl class="order-detail-grid">
            <dt>Status</dt>
            <dd><span class="my-order-status status-{{ order.status }}">{{ order.status|capitalize }}</span></dd>
            <dt>Total</dt>
            <dd>₱{{ order.totalAmount|number_format(2, '.', ',') }}</dd>
            <dt>Quantity</dt>
            <dd>{{ order.quantity }} item(s)</dd>
            <dt>Items</dt>
            <dd>{{ order.description }}</dd>
            {% if order.customer %}
                <dt>Customer</dt>
                <dd>{{ order.customer.name }}</dd>
                <dt>Email</dt>
                <dd>{{ order.customer.email }}</dd>
                <dt>Phone</dt>
                <dd>{{ order.customer.phoneNumber }}</dd>
            {% endif %}
        </dl>

        <h2 class="order-products-heading">Products</h2>
        <ul class="order-products-list">
            {% for product in order.product %}
                <li>{{ product.name }} — ₱{{ product.price|number_format(2, '.', ',') }}</li>
            {% endfor %}
        </ul>

        <a href="{{ path('app_shop') }}" class="btn-shop-cart">Shop Again</a>
    </div>
</div>

<script>
    function refreshOrderDetail() {
        fetch(window.location.href)
            .then(response => response.text())
            .then(htmlString => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(htmlString, 'text/html');
                const incoming = doc.getElementById('live-customer-order-detail-container');
                const current = document.getElementById('live-customer-order-detail-container');
                if (incoming && current && incoming.innerHTML.trim() !== current.innerHTML.trim()) {
                    current.innerHTML = incoming.innerHTML;
                }
            })
            .catch(err => console.warn("Order detail sync missed", err));
    }

    // Check every 5 seconds
    setInterval(refreshOrderDetail, 5000);

    // WebSocket Turbo
    const SOCKET_URL = 'ws://localhost:8080';
    let socket;
    function connectWS() {
        socket = new WebSocket(SOCKET_URL);
        socket.onmessage = (e) => {
            const data = JSON.parse(e.data);
            if ((data.type === 'order.updated' || data.type === 'order.created') && 
                (data.data && data.data.orderId == {{ order.id }})) {
                refreshOrderDetail();
            }
        };
        socket.onclose = () => setTimeout(connectWS, 5000);
    }
    connectWS();
</script>
{% endblock %}
