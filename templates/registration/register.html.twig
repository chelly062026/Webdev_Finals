{% block body %}
	{{ include('homepage/nav.html.twig') }}

	<style>
		@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600 &display=swap');:root {
			--primary-color: #f533b4;
			--primary-hover: #6c4a5a;
			--bg-gradient: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
			--text-dark: #1f2937;
			--glass-bg: rgba(255, 255, 255, 0.95);
		}

		body {
			font-family: 'Montserrat', sans-serif;
			background: var(--bg-gradient);
			min-height: 100vh;
			margin: 0;
		}

		/* Main Wrapper */
		.register-container {
			display: flex;
			justify-content: center;
			align-items: center;
			padding: 60px 20px;
			min-height: calc(100vh - 100px);
		}

		/* The Card */
		.form-wrapper {
			display: flex;
			background: var(--glass-bg);
			border-radius: 20px;
			box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
			overflow: hidden;
			width: 100%;
			max-width: 1000px;
			min-height: 600px;
		}

		/* Left Side: Image Container */
		.image-side {
			flex: 1;
			background-color: #fce7f3;
			display: flex;
			overflow: hidden;
		}

		.image-side img {
			width: 100%;
			height: 100%;
			object-fit: cover; /* Prevents stretching */
			display: block;
		}

		/* Right Side: Form Container */
		form {
			flex: 1;
			padding: 3rem;
			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		h1 {
			font-weight: 600;
			color: var(--text-dark);
			margin-bottom: 1.5rem;
			text-align: center;
			letter-spacing: -0.5px;
		}

		/* Symfony Form Row Styling */
		.mb-3,
		div[class^="form-group"],
		form > div {
			margin-bottom: 1.2rem;
		}

		label {
			display: block;
			font-weight: 600;
			font-size: 0.85rem;
			margin-bottom: 0.5rem;
			color: #4b5563;
		}

		input[type="text"],
		input[type="email"],
		input[type="password"] {
			width: 100%;
			padding: 12px 16px;
			border: 1px solid #d1d5db;
			border-radius: 8px;
			font-family: 'Montserrat', sans-serif;
			font-size: 0.95rem;
			transition: all 0.2s ease;
			box-sizing: border-box;
		}

		input:focus {
			outline: none;
			border-color: var(--primary-color);
			box-shadow: 0 0 0 4px rgba(245, 51, 180, 0.1);
		}

		input[type="checkbox"] {
			margin-right: 8px;
			accent-color: var(--primary-color);
		}

		/* Button Styling */
		.btn {
			width: 100%;
			background-color: var(--primary-color);
			color: white;
			padding: 14px;
			border: none;
			border-radius: 8px;
			font-family: 'Montserrat', sans-serif;
			font-weight: 600;
			font-size: 1rem;
			cursor: pointer;
			transition: all 0.2s ease;
			margin-top: 1rem;
		}

		.btn:hover {
			background-color: var(--primary-hover);
			transform: translateY(-2px);
		}

		.login-link {
			text-align: center;
			margin-top: 1.5rem;
			font-size: 0.9rem;
			color: #6b7280;
		}

		.login-link a {
			color: var(--primary-color);
			text-decoration: none;
			font-weight: 600;
		}

		.login-link a:hover {
			text-decoration: underline;
		}

		/* Error Messages */
		.alert-danger,
		ul {
			list-style: none;
			padding: 10px;
			background: #fef2f2;
			border-radius: 8px;
			color: #dc2626;
			font-size: 0.85rem;
			margin-bottom: 1rem;
		}

		/* Tablet & Mobile Responsive */
		@media(max-width: 900px) {
			.form-wrapper {
				flex-direction: column;
				max-width: 500px;
			}
			.image-side {
				height: 300px;
				flex: none;
			}
			form {
				padding: 2rem;
			}
		}
	</style>

	<div class="register-container">
		<div class="form-wrapper">

			<div class="image-side">
				<img src="{{ asset('about/model1.png') }}" alt="Registration Background">
			</div>

			{{ form_start(registrationForm) }}
			<h1>Create Account</h1>

			{{ form_errors(registrationForm) }}

			<div class="form-body">
				{{ form_row(registrationForm.username) }}
				{{ form_row(registrationForm.email) }}
				{{ form_row(registrationForm.plainPassword, {
                        label: 'Password'
                    }) }}

				<div class="terms-row">
					{{ form_row(registrationForm.agreeTerms) }}
				</div>

				<button type="submit" class="btn">Register</button>
			</div>

			<div class="login-link">
				Already have an account?
				<a href="{{ path('app_login') }}">Log in here</a>
			</div>
			{{ form_end(registrationForm) }}

		</div>
	</div>
{% endblock %}
