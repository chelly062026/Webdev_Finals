{% extends 'base.html.twig' %}

{% block title %}Product{% endblock %}

{% block body %}

<style>
    /* Page Wrapper */
    .page-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 32px;
        width: 100%;
        min-height: 100vh;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
        overflow-y: auto;
    }

    /* Card Container */
    .detail-card {
        background: #ffffff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        max-width: 600px;
        margin: 0 auto;
    }

    .detail-card h1 {
        text-align: center;
        color: #333;
        margin-bottom: 25px;
    }

    /* Table Styling */
    .detail-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
    }

    .detail-table th {
        text-align: left;
        padding: 12px;
        width: 35%;
        background: #f4f6f9;
        color: #555;
        font-weight: 600;
        border-bottom: 1px solid #e0e0e0;
    }

    .detail-table td {
        padding: 12px;
        color: #333;
        border-bottom: 1px solid #eee;
        transition: background 0.2s ease;
    }

    .detail-table tr:hover td {
        background-color: rgba(146, 39, 143, 0.05);
    }

    /* Actions Section */
    .actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .btn-primary, .btn-secondary {
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .btn-primary {
        background: #92278f;
        color: #fff;
        border: none;
    }

    .btn-primary:hover {
        background: #b344a1;
    }

    .btn-secondary {
        background: #f4f6f9;
        color: #555;
        border: 1px solid #ccc;
    }

    .btn-secondary:hover {
        background: #92278f;
        color: #fff;
    }

    /* Delete Button */
    .actions form button {
        padding: 10px 18px;
        border-radius: 8px;
        border: none;
        background: #dc3545;
        color: #fff;
        cursor: pointer;
        transition: background 0.3s ease;
    }

    .actions form button:hover {
        background: #b52a37;
    }
</style>

<div class="page-wrapper">
    <div class="detail-card">
        <h1>Product Details</h1>

        <table class="detail-table">
            <tbody>
                <tr>
                    <th>ID</th>
                    <td>{{ product.id }}</td>
                </tr>
                <tr>
                    <th>Name</th>
                    <td>{{ product.name }}</td>
                </tr>
                <tr>
                    <th>Image</th>
                    <td>
                        {% if product.image %}
                            <img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}" style="max-width:220px;border-radius:8px;">
                        {% else %}
                            No image uploaded
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ product.description }}</td>
                </tr>
                <tr>
                    <th>Price</th>
                    <td>₱{{ product.price }}</td>
                </tr>
                <tr>
                    <th>Stock</th>
                    <td>
                        {{ product.stock ?? 'N/A' }}
                        {% if product.stock is not null and product.stock <= 5 %}
                            <span style="display:inline-block; margin-left:0.75rem; padding:0.25rem 0.55rem; border-radius:0.35rem; background:#f8d7da; color:#842029; font-weight:600; font-size:0.85rem;">Low stock</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Created At</th>
                    <td>{{ product.createdAt ? product.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                </tr>
            </tbody>
        </table>

        <div class="actions">
            <a class="btn-secondary" href="{{ path('app_product_index') }}">
                ← Back to list
            </a>

            {# Determine whether the current user can edit: admin, the creator, or staff managing admin-created products #}
            {% set createdBy = product.createdBy is defined ? product.createdBy : null %}
            {% set createdByCurrentUser = app.user and createdBy and createdBy.id is defined and createdBy.id == app.user.id %}
            {% set createdByAdmin = createdBy and createdBy.roles is defined and 'ROLE_ADMIN' in createdBy.roles %}
            {% set canManageProduct = is_granted('ROLE_ADMIN') or createdByCurrentUser or (is_granted('ROLE_STAFF') and createdByAdmin) %}

            {% if canManageProduct %}
                <a class="btn-primary" href="{{ path('app_product_edit', {'id': product.id}) }}">
                    Edit
                </a>

                {{ include('product/_delete_form.html.twig') }}
            {% endif %}
        </div>
    </div>
</div>

{% endblock %}
