{% extends 'base.html.twig' %}

{% block title %}Product index{% endblock %}

{% block body %}

<link rel="stylesheet" href="{{ asset('styles/dashboardproductindex.css') }}">
<style>
    .stock-badge {
        display: inline-block;
        padding: 0.35rem 0.7rem;
        border-radius: 0.35rem;
        font-weight: 600;
    }

    .stock-normal {
        background: #e7f1ff;
        color: #084298;
        border: 1px solid #b6d4fe;
    }

    .stock-low {
        background: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
    }
</style>

<div class="container-fluid">
    <div class="page-header">
        <h1>Product Management</h1>
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
            <a href="{{ path('app_product_new') }}" class="btn btn-primary">
                <i data-feather="plus-circle" class="me-2"></i>Create New Product
            </a>
        {% endif %}
    </div>

    <div class="table-container">
        <table id="productTable" class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for product in products %}
                {% set createdByAdmin = product.createdBy is not null and product.createdBy.roles is defined and 'ROLE_ADMIN' in product.createdBy.roles %}
                {% set createdByCurrentUser = app.user and product.createdBy is not null and product.createdBy.id == app.user.id %}
                <tr>
                    <td><strong>#{{ product.id }}</strong></td>
                    <td>{{ product.name }}</td>
                    <td>{{ product.description }}</td>
                    <td><span class="price-badge">₱{{ product.price|number_format(2, '.', ',') }}</span></td>
                    <td>
                        <span class="stock-badge {{ product.stock is not null and product.stock <= lowStockThreshold ? 'stock-low' : 'stock-normal' }}">
                            {{ product.stock ?? 'N/A' }}
                        </span>
                        {% if product.stock is not null and product.stock <= lowStockThreshold %}
                            <span class="badge bg-warning text-dark ms-1">Low stock</span>
                        {% endif %}
                    </td>
                    <td><span class="date-badge">{{ product.createdAt ? product.createdAt|date('M d, Y') : 'N/A' }}</span></td>
                    <td>
                        <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn btn-sm btn-info" title="View Details">
                            <i data-feather="eye"></i> View
                        </a>

                        {% set canManageProduct = is_granted('ROLE_ADMIN') or createdByCurrentUser or (is_granted('ROLE_STAFF') and createdByAdmin) %}

                        {% if canManageProduct %}
                            <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-sm btn-warning" title="Edit Product">
                                <i data-feather="edit"></i> Edit
                            </a>
                            <form method="POST" action="{{ path('app_product_delete', {'id': product.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                <button type="submit" class="btn btn-sm btn-danger" title="Delete Product">
                                    <i data-feather="trash"></i> Delete
                                </button>
                            </form>
                        {% else %}
                            <span class="text-muted" style="font-size: 11px; padding: 4px 8px; background: #f3f4f6; border-radius: 4px;">
                                <i data-feather="lock" class="me-1"></i>Admin Product
                            </span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center">
                        <i data-feather="package" class="mb-3" style="color: #d1d5db; width: 48px; height: 48px;"></i>
                        <p>No products found. Click "Create New Product" to add your first product.</p>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script src="https://unpkg.com/feather-icons/dist/feather.min.js"></script>
    <script>
        feather.replace();
    </script>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        new DataTable('#productTable', {
            responsive: true,
            pageLength: 10,
            lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]],
            order: [[0, 'desc']],
            columnDefs: [
                { orderable: false, targets: 6 } // Disable sorting on Actions column
            ],
            language: {
                search: "Search products:",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                infoEmpty: "Showing 0 to 0 of 0 entries",
                infoFiltered: "(filtered from _MAX_ total entries)",
                zeroRecords: "No matching products found",
                paginate: { first: "First", last: "Last", next: "Next", previous: "Previous" }
            }
        });
    });
</script>
{% endblock %}
