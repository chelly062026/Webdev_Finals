{% extends 'base.html.twig' %}

{% block title %}Customer{% endblock %}

{% block body %}

<style>
    /* Card Container */
    .detail-card {
        background: #ffffff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        max-width: 600px;
        margin: 20px auto;
        font-family: Arial, sans-serif;
    }

    .detail-card h1 {
        text-align: center;
        color: #333;
        margin-bottom: 25px;
    }

    /* Table Styling */
    .detail-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
    }

    .detail-table th {
        text-align: left;
        padding: 12px;
        width: 35%;
        background: #f4f6f9;
        color: #555;
        font-weight: 600;
        border-bottom: 1px solid #e0e0e0;
    }

    .detail-table td {
        padding: 12px;
        color: #333;
        border-bottom: 1px solid #eee;
        transition: background 0.2s ease;
    }

    .detail-table tr:hover td {
        background-color: rgba(146, 39, 143, 0.05);
    }

    /* Buttons */
    .actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .btn-primary, .btn-secondary {
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .btn-primary {
        background: #92278f;
        color: #fff;
        border: none;
    }

    .btn-primary:hover {
        background: #b344a1;
    }

    .btn-secondary {
        background: #f4f6f9;
        color: #555;
        border: 1px solid #ccc;
    }

    .btn-secondary:hover {
        background: #92278f;
        color: #fff;
    }

    /* Delete Button */
    .actions form button {
        padding: 10px 18px;
        border-radius: 8px;
        border: none;
        background: #dc3545;
        color: #fff;
        cursor: pointer;
        transition: background 0.3s ease;
    }

    .actions form button:hover {
        background: #b52a37;
    }
</style>

<div class="detail-card">
    <h1>Customer</h1>

    <table class="detail-table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ customer.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ customer.name }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ customer.email }}</td>
            </tr>
            <tr>
                <th>Phone Number</th>
                <td>{{ customer.phoneNumber }}</td>
            </tr>
        </tbody>
    </table>

    <div class="actions">
        <a class="btn-secondary" href="{{ path('app_customer_index') }}">← Back to list</a>

        {# Allow admins and staff editing/admin-created customers #}
        {% set createdBy = customer.createdBy is defined ? customer.createdBy : null %}
        {% set createdByAdmin = createdBy and createdBy.roles is defined and 'ROLE_ADMIN' in createdBy.roles %}
        {% set createdByCurrentUser = app.user and createdBy and createdBy.id is defined and createdBy.id == app.user.id %}
        {% set canManageCustomer = is_granted('ROLE_ADMIN') or createdByCurrentUser or (is_granted('ROLE_STAFF') and createdByAdmin) %}

        {% if canManageCustomer %}
            <a class="btn-primary" href="{{ path('app_customer_edit', {'id': customer.id}) }}">Edit</a>
            {{ include('customer/_delete_form.html.twig') }}
        {% endif %}
    </div>
</div>

{% endblock %}
