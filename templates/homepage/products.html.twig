<script>
    function updatePreview(element, mainImgId) {
        const mainImg = document.getElementById(mainImgId);
        if (!mainImg) {
            return;
        }

        mainImg.src = element.src;

        const thumbBar = element.closest('.product-thumb-bar');
        if (!thumbBar) {
            return;
        }

        thumbBar.querySelectorAll('.thumb-item').forEach((thumb) => {
            thumb.classList.remove('active');
        });

        element.classList.add('active');
    }
</script>