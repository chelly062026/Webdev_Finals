    .social-icon:hover { background: #dc7eb5; transform: scale(1.1); }
    .copyright { font-family: 'Montserrat', sans-serif; font-size: 12px; color: #ff0095; border-top: 1px solid #d0d0d0; padding-top: 20px; }

    .contact-cta-section { padding: 80px 0; background: #fff; }
    .contact-cta-inner { max-width: var(--max-width); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; background: #fff; border-radius: 28px; padding: 42px 46px; box-shadow: 0 30px 80px rgba(0,0,0,0.08); }
    .contact-cta-label { margin: 0 0 12px; font-size: 13px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: #ff0095; }
    .contact-cta-inner h2 { font-size: 48px; margin: 0 0 16px; color: #171717; }
    .contact-cta-inner p { margin: 0; font-size: 17px; color: #666; max-width: 560px; }
    .contact-cta-btn { display: inline-flex; align-items: center; justify-content: center; background: #ff0095; color: #fff; padding: 20px 40px; border-radius: 999px; font-size: 15px; font-weight: 700; text-decoration: none; transition: transform 0.25s ease, background 0.25s ease; }
    .contact-cta-btn:hover { background: #e60086; transform: translateY(-1px); }

    /* ── Responsive ── */
    @media (max-width: 768px) {
        .navbar-custom { padding: 15px 20px; }
        .nav-links { gap: 20px; }
        .hero-section { grid-template-columns: 1fr; padding: 40px 20px; }
        .hero-content { padding-right: 0; }
        .hero-heading { font-size: 32px; }
        .products-section { grid-template-columns: 1fr; padding: 40px 20px; }
        .category-sidebar { grid-column: 1; display: flex; gap: 20px; background: transparent; }
        .collection-grid { grid-template-columns: repeat(2, 1fr); }
        .about-section { grid-template-columns: 1fr; padding: 40px 20px; }
        .contact-cta-section { padding: 60px 20px; }
        .contact-cta-inner { max-width: var(--max-width); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; background: #fff; border-radius: 24px; padding: 36px; box-shadow: 0 20px 50px rgba(0,0,0,0.08); }
        .contact-cta-label { margin: 0 0 12px; font-size: 13px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: #ff0095; }
        .contact-cta-inner h2 { font-size: 40px; margin: 0 0 16px; color: #000; }
        .contact-cta-inner p { margin: 0 0 0; font-size: 16px; color: #444; }
        .contact-cta-btn { display: inline-flex; align-items: center; justify-content: center; background: #ff0095; color: #fff; padding: 18px 34px; border-radius: 999px; font-size: 15px; font-weight: 700; text-decoration: none; transition: transform 0.25s ease, background 0.25s ease; }
        .contact-cta-btn:hover { background: #e60086; transform: translateY(-1px); }
        .footer-content { flex-direction: column; gap: 15px; }
        .footer-contact { grid-template-columns: 1fr; padding: 20px; gap: 20px; }
        .shop-wrapper { padding: 40px 20px; }
        .shop-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    }

    @media (max-width: 480px) {
        .shop-grid { grid-template-columns: 1fr; }
        .category-gallery { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block body %}
<!-- Navbar -->
{{ include('homepage/nav.html.twig') }}

{% if show_products is defined and show_products %}
{# ── PRODUCTS PAGE VIEW ── #}
<div class="shop-wrapper">
    <h1 class="shop-heading">Our Products</h1>
    <p class="shop-subheading">Find something you love!</p>

    {% if products|length > 0 %}
        <div class="shop-grid">
            {% for product in products %}
                <div class="shop-card">
                    <div class="shop-card-img">
                        {{ include('shop/_product_image.html.twig', {product: product, loop_index: loop.index0}) }}
                    </div>
                    <div class="shop-card-body">
                        <div class="shop-card-name">{{ product.name }}</div>
                        <div class="shop-card-desc">{{ product.description }}</div>
                        <div class="shop-card-footer">
                            <span class="shop-price">₱{{ product.price|number_format(2, '.', ',') }}</span>
                            {{ include('shop/_add_to_cart.html.twig', {
                                product: product,
                                redirect: path('app_homepage'),
                                button_class: 'shop-btn-view',
                            }) }}
                            <a href="{{ path('app_shop_product_show', {'id': product.id}) }}" class="shop-btn-view">View</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="shop-empty">No products available yet. Check back soon!</div>
    {% endif %}
</div>

{% else %}
{# ── HOMEPAGE VIEW ── #}

<!-- Hero Section -->
{{ include('homepage/hero.html.twig') }}

<!-- Products Preview -->
{{ include('homepage/products.html.twig') }}

<!-- Collection Highlights -->
{{ include('homepage/collections.html.twig') }}
<!-- About Us -->
{{ include('homepage/aboutus.html.twig') }}
<!-- Contact CTA -->
<section class="contact-cta-section">
    <div class="contact-cta-inner">
        <div>
            <p class="contact-cta-label">Ready to talk?</p>
            <h2>Write to Us</h2>
            <p>Have a project idea or a question? Send us a message and we’ll get back to you soon.</p>
        </div>
        <a href="{{ path('app_contact') }}" class="contact-cta-btn">Write to Us</a>
    </div>
</section>
<!-- Subscribe -->
<div class="subscribe-section">
    <h3 class="subscribe-title">Subscribe to us!</h3>
    <p style="color:#666;margin-bottom:20px;font-size:14px;font-family:'Montserrat',sans-serif;">Enter your email for latest updates</p>
    <form class="subscribe-form" id="subscribeForm">
        <input type="email" placeholder="Enter your email" required>
        <button type="submit">Subscribe</button>
    </form>
    <div class="subscribe-message" id="subscribeMessage">Thanks for subscribing!</div>
</div>

{% endif %}

<!-- Footer -->
{{ include('homepage/footer.html.twig') }}
<script>
    {% if show_products is not defined or not show_products %}
    document.getElementById('subscribeForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const emailInput = this.querySelector('input[type="email"]');
        const message = document.getElementById('subscribeMessage');
        if (emailInput.value) {
            message.style.display = 'block';
            emailInput.value = '';
            setTimeout(() => { message.style.display = 'none'; }, 3000);
        }
    });
    {% endif %}
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) target.scrollIntoView({ behavior: 'smooth' });
        });
    });

    const contactForm = document.getElementById('contactForm');
    const contactSuccess = document.getElementById('contactSuccess');
    if (contactForm) {
        contactForm.addEventListener('submit', function(e) {
            e.preventDefault();
            contactSuccess.style.display = 'block';
            setTimeout(() => { contactSuccess.style.display = 'none'; }, 4000);
            this.reset();
        });
    }

    // Category Modal Functionality
    const categoryData = {
        'plain-shirt': {
            title: 'Plain Shirt',
            images: ['plain1.png', 'plain2.png', 'plain3.png', 'plain4.png']
        },
        'printed-shirt': {
            title: 'Printed Shirt',
            images: ['product1.png', 'product2.png', 'product3.png', 'product4.png']
        },
        'customize-shirt': {
            title: 'Customize Shirt',
            images: ['model1.png', 'model2.png', 'product1.png', 'product2.png']
        }
    };

    const categoryModal = document.getElementById('categoryModal');
    const categoryModalClose = document.getElementById('categoryModalClose');
    const categoryModalTitle = document.getElementById('categoryModalTitle');
    const categoryGallery = document.getElementById('categoryGallery');

    document.querySelectorAll('.category-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const category = this.dataset.category;
            const data = categoryData[category];
            
            if (data) {
                categoryModalTitle.textContent = data.title;
                categoryGallery.innerHTML = '';
                
                data.images.forEach(image => {
                    const card = document.createElement('div');
                    card.className = 'category-image-card';
                    card.innerHTML = `<img src="{{ asset('') }}{image}" alt="{data.title}" />`.replace('{image}', image).replace('{data.title}', data.title);
                    categoryGallery.appendChild(card);
                });
                
                categoryModal.classList.add('active');
            }
        });
    });

    categoryModalClose.addEventListener('click', function() {
        categoryModal.classList.remove('active');
    });

    categoryModal.addEventListener('click', function(e) {
        if (e.target === categoryModal) {
            categoryModal.classList.remove('active');
        }
    });
</script>
{% endblock %}
