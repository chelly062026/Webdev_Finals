    /* ── Category Modal ── */
    .category-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.6); z-index: 1000; align-items: center; justify-content: center; }
    .category-modal.active { display: flex; }
    .category-modal-content { background: white; border-radius: 20px; padding: 40px; max-width: 900px; width: 90%; max-height: 90vh; overflow-y: auto; position: relative; }
    .category-modal-close { position: absolute; top: 15px; right: 15px; font-size: 28px; cursor: pointer; color: #ff0095; font-weight: bold; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f4eff7; transition: all 0.2s; }
    .category-modal-close:hover { background: #ff0095; color: white; }
    .category-modal-title { font-family: 'Montserrat', sans-serif; font-size: 28px; font-weight: 900; margin-bottom: 30px; color: #ff0095; text-align: center; }
    .category-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
    .category-image-card { background: #f5f5f5; border-radius: 12px; overflow: hidden; cursor: pointer; transition: all 0.3s ease; }
    .category-image-card:hover { transform: translateY(-5px); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12); }
    .category-image-card img { width: 100%; height: 300px; object-fit: cover; display: block; }


    /* ── Full Products Grid (shop view) ── */
    .shop-wrapper { padding: 60px; background: #fff; min-height: 100vh; }
    .shop-heading { font-family: 'Montserrat', sans-serif; font-size: 32px; font-weight: 900; color: #ff0095; margin-bottom: 8px; }
    .shop-subheading { font-family: 'Montserrat', sans-serif; font-size: 16px; color: #ff0095; font-style: italic; margin-bottom: 40px; }
    .shop-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 32px; }
    .shop-card { background: #f5f5f5; border-radius: 10px; overflow: hidden; transition: transform 0.3s ease, box-shadow 0.3s ease; cursor: pointer; position: relative; }
    .shop-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
    .shop-card-img { background: #e8d0e0; height: 280px; display: flex; align-items: center; justify-content: center; color: #999; font-size: 14px; font-family: 'Montserrat', sans-serif; }
    .shop-card-img img { width: 100%; height: 100%; object-fit: cover; }
    .shop-card-body { padding: 16px; }
    .shop-card-name { font-family: 'Montserrat', sans-serif; font-size: 15px; font-weight: 700; color: #ff0095; margin-bottom: 6px; }
    .shop-card-desc { font-family: 'Montserrat', sans-serif; font-size: 13px; color: #ff0095; margin-bottom: 12px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .shop-card-footer { display: flex; justify-content: space-between; align-items: center; }
    .shop-price { font-family: 'Montserrat', sans-serif; font-size: 16px; font-weight: 900; color: #ff0095; }
    .shop-btn-view { font-family: 'Montserrat', sans-serif; background: #dc7eb5; color: #000; border: none; padding: 8px 18px; border-radius: 20px; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none; transition: background 0.3s ease; }
    .shop-btn-view:hover { background: #dc7eb5; color: #000; }
    .shop-empty { text-align: center; padding: 80px 20px; color: #ff0095; font-family: 'Montserrat', sans-serif; font-size: 16px; }

    /* ── Footer Contact Us Style ── */
    .footer-contact { background: transparent; padding: 40px 40px 25px; border-radius: 20px; display: grid; grid-template-columns: repeat(5, minmax(120px, 1fr)); gap: 24px; }
    .footer-column h3, .footer-column h4 { margin: 0 0 14px; font-family: 'Montserrat', sans-serif; color: #ff0095; }
    .footer-column h3 { font-size: 24px; }
    .footer-column h4 { font-size: 16px; font-weight: 700; }
    .footer-column a, .footer-column .footer-item { display: block; font-family: 'Montserrat', sans-serif; font-size: 14px; color: #ff0095; margin-bottom: 8px; text-decoration: none; }
    .footer-column a:hover { color: #dc7eb5; }
    .footer-socials { display: flex; gap: 10px; margin-top: 10px; }
    .footer-socials .social-icon { width: 32px; height: 32px; border-radius: 50%; font-size: 12px; color: #ff0095; background: #e6deed; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; }
    .footer-copyright { margin-top: 18px; text-align: center; color: #63073c; font-family: 'Montserrat', sans-serif; font-size: 13px; }

    /* ── Subscribe ── */
