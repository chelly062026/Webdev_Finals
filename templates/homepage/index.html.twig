        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        width: fit-content;
    }

    .browse-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(186, 149, 175, 0.3);
    }
}

