    .subscribe-form { display: flex; gap: 10px; max-width: 500px; margin: 0 auto; justify-content: center; }
    .subscribe-form input { font-family: 'Montserrat', sans-serif; flex: 1; padding: 12px 15px; border: 1px solid #d0d0d0; border-radius: 5px; font-size: 14px; }
