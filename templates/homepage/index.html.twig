{% extends 'base.html.twig' %}

{% block title %}{% if show_products is defined and show_products %}Products - Chelswear{% else %}Homepage - Chelswear{% endif %}{% endblock %}

{% block stylesheets %}
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body { font-family: 'Montserrat', sans-serif; background: linear-gradient(180deg, #f7f1f8 0%, #f0e6f4 100%); }

    .content { margin-left: 0 !important; width: 100% !important; padding: 0 !important; min-height: 100vh; }
    .sidebar { display: none !important; }
    .alert { display: none; }

    /* ── Hero Section ── */
    .hero-section { display: grid; grid-template-columns: 1fr 1fr; background: #dc7eb5; min-height: 500px; align-items: center; padding: 60px; gap: 40px; }
    .hero-content { padding-right: 40px; }
    .hero-brand { font-family: 'Brush Script MT', cursive; font-size: 100px; color: #71134a; margin-bottom: 10px; font-weight: 400; }
    .hero-heading { font-family: 'Montserrat', sans-serif; font-size: 30px; font-weight: 900; color: #71134a; line-height: 1.2; margin-bottom: 20px; }
    .hero-tagline { font-family: 'Montserrat', sans-serif; font-size: 16px; color: #71134a; font-style: italic; margin-bottom: 30px; }
    .shop-btn { font-family: 'Montserrat', sans-serif; background: linear-gradient(135deg, #c32f90 0%, #9c2b85 100%); color: #fff; padding: 14px 32px; border: none; border-radius: 999px; font-weight: 700; cursor: pointer; transition: all 0.3s ease; font-size: 14px; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; box-shadow: 0 18px 40px rgba(195, 47, 144, 0.18); }
    .shop-btn:hover { background: linear-gradient(135deg, #a52a78 0%, #7e2468 100%); transform: translateX(2px); }
    .hero-image { position: relative; display: flex; gap: 20px; justify-content: center; align-items: center; min-height: 420px; }
    .hero-image img { max-width: 100%; height: auto; border-radius: 16px; box-shadow: 0 12px 30px rgba(0,0,0,0.18); object-fit: cover; }
    .hero-image .model-1 { width: 55%; border: 4px solid #fff; transform: translateX(-15px); z-index: 2; }
    .hero-image .model-2 { width: 45%; border: 4px solid #fff; transform: translateX(15px) scale(0.96); opacity: 0.95; z-index: 1; }

    /* Import global styles */
@import url('global.css');

/* About Us Page Specific Styles */

:root {
    --neutral-bg: #f4f6f3;
    /* Light sage/beige */
    --accent-color: #ba95af;
    /* Muted dusty rose */
    --text-dark: #1a1a1a;
    --text-muted: #777;
}

body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
}

/* About Section */
.about-section {
    background: var(--neutral-bg);
    padding: 120px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
}

/* Large background text like the reference */
.bg-text-watermark {
    position: absolute;
    bottom: 5%;
    left: 0;
    right: 0;
    font-family: var(--primary-font);
    font-size: 18vw;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.7);
    text-align: center;
    z-index: 1;
    pointer-events: none;
    text-transform: uppercase;
    letter-spacing: -5px;
}

.about-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    gap: 40px;
    max-width: var(--max-width);
    width: 100%;
    z-index: 2;
    align-items: center;
}

    .about-left,
    .about-right {
        display: flex;
        flex-direction: column;
        justify-content: center;
        width: 100%;
    }

.about-image-wrapper {
    display: flex;
    justify-content: center;
    position: relative;
}

.about-image-wrapper img {
    width: 100%;
    max-width: 480px;
    height: auto;
    filter: drop-shadow(0 20px 50px rgba(0, 0, 0, 0.1));
}

.about-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.about-description {
    font-family: var(--primary-font);
    color: var(--text-dark);
    line-height: 1.8;
    font-size: 1.05rem;
}

.browse-btn {
    display: inline-block;
    margin-top: 35px;
    background: var(--accent-color);
    color: white;
    padding: 16px 35px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 1px;
    transition: var(--transition-normal);
    width: fit-content;
}

.browse-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(186, 149, 175, 0.3);
}

/* Team Section */
.team-section {
    background: #ffffff;
    padding: 120px 60px;
    text-align: center;
}

.team-title {
    font-family: var(--primary-font);
    font-size: 2.5rem;
    font-weight: 500;
    color: var(--text-dark);
    margin-bottom: 15px;
    letter-spacing: -1px;
}

.team-subtitle {
    font-family: var(--primary-font);
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 80px;
    font-weight: 300;
}

.team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    max-width: var(--max-width);
    margin: 0 auto;
}

.team-member {
    background: transparent;
    text-align: left;
}

.team-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--neutral-bg);
    margin-bottom: 25px;
}

.team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: var(--transition-slow);
}

.team-member:hover img {
    filter: grayscale(0%);
    transform: scale(1.08);
}

.team-info {
    padding-top: 15px;
    border-top: 1px solid #eaeaea;
}

.team-name {
    font-family: var(--primary-font);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-dark);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 5px;
}

.team-role {
    font-family: var(--primary-font);
    font-size: 0.85rem;
    color: var(--accent-color);
    font-weight: 500;
    letter-spacing: 0.5px;
}

/* Responsive Design */
@media (max-width: 1024px) {
    .about-container {
        grid-template-columns: 1fr;
        gap: 60px;
        text-align: center;
    }

    .about-header-main {
        font-size: 3rem;
    }

    .about-quote {
        margin: 20px auto;
        text-align: left;
    }

    .about-right {
        align-items: center;
    }

    .team-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .bg-text-watermark {
        display: none;
    }
}

@media (max-width: 576px) {
    .team-grid {
        grid-template-columns: 1fr;
    }

    .about-header-main {
        font-size: 2.2rem;
    }

    .about-section {
        padding: 80px 20px;
    }

    .browse-btn {
        margin-top: 35px;
        background: var(--accent-color);
