{% extends 'base.html.twig' %}

{% block title %}About Us - Chelswear{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('styles/aboutus.css') }}">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Montserrat', sans-serif; background: linear-gradient(180deg, #f7f1f8 0%, #f0e6f4 100%); }
    .content { margin-left: 0 !important; width: 100% !important; padding: 0 !important; min-height: 100vh; }
    .sidebar { display: none !important; }
    .alert { display: none; }

    /* ── Footer Contact Us Style ── */
    .footer-contact { background: transparent; padding: 40px 40px 25px; border-radius: 20px; display: flex; flex-wrap: wrap; justify-content: center; gap: 32px; }
    .footer-column { flex: 0 1 auto; min-width: 150px; }
    .footer-column h3, .footer-column h4 { margin: 0 0 14px; font-family: 'Montserrat', sans-serif; color: #ff0095; }
    .footer-column h3 { font-size: 24px; }
    .footer-column h4 { font-size: 16px; font-weight: 700; }
    .footer-column a, .footer-column .footer-item { display: block; font-family: 'Montserrat', sans-serif; font-size: 14px; color: #ff0095; margin-bottom: 8px; text-decoration: none; }
    .footer-column a:hover { color: #dc7eb5; }
    .footer-socials { display: flex; gap: 10px; margin-top: 10px; }
    .footer-socials .social-icon { width: 32px; height: 32px; border-radius: 50%; font-size: 12px; color: #ff0095; background: #e6deed; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; }
    .footer-copyright { margin-top: 18px; text-align: center; color: #63073c; font-family: 'Montserrat', sans-serif; font-size: 13px; }

    /* ── Footer ── */
    .footer { background: #f0f0f0; padding: 40px 60px; text-align: center; border-top: 1px solid #d0d0d0; }

    /* ── Responsive ── */
    @media (max-width: 768px) {
        .footer { padding: 40px 20px; }
        .footer-contact { padding: 20px; flex-direction: column; align-items: center; gap: 20px; }
    }
</style>
{% endblock %}

{% block body %}
{{ include('homepage/nav.html.twig') }}
{{ include('homepage/aboutus.html.twig') }}
{{ include('homepage/footer.html.twig') }}
{% endblock %}
