{% extends 'base.html.twig' %}

{% block title %}Meet Our Team - Chelswear{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('styles/aboutus.css') }}">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Montserrat', sans-serif; background: linear-gradient(180deg, #f7f1f8 0%, #f0e6f4 100%); }
    .content { margin-left: 0 !important; width: 100% !important; padding: 0 !important; min-height: 100vh; }
    .sidebar { display: none !important; }
    .alert { display: none; }

    .back-arrow { text-align: left; padding: 20px; }
    .back-arrow a { font-family: 'Montserrat', sans-serif; font-size: 16px; color: #ff0095; text-decoration: none; }
    .back-arrow a:hover { color: #dc7eb5; }

    /* ── Footer Contact Us Style ── */
    .footer-contact { background: transparent; padding: 40px 40px 25px; border-radius: 20px; display: grid; grid-template-columns: repeat(5, minmax(120px, 1fr)); gap: 24px; }
    .footer-column h3, .footer-column h4 { margin: 0 0 14px; font-family: 'Montserrat', sans-serif; color: #ff0095; }
    .footer-column h3 { font-size: 24px; }
    .footer-column h4 { font-size: 16px; font-weight: 700; }
    .footer-column a, .footer-column .footer-item { display: block; font-family: 'Montserrat', sans-serif; font-size: 14px; color: #ff0095; margin-bottom: 8px; text-decoration: none; }
    .footer-column a:hover { color: #dc7eb5; }
    .footer-socials { display: flex; gap: 10px; margin-top: 10px; }
    .footer-socials .social-icon { width: 32px; height: 32px; border-radius: 50%; font-size: 12px; color: #ff0095; background: #e6deed; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; }
    .footer-copyright { margin-top: 18px; text-align: center; color: #63073c; font-family: 'Montserrat', sans-serif; font-size: 13px; }

    /* ── Footer ── */
    .footer { background: #f0f0f0; padding: 40px 60px; text-align: center; border-top: 1px solid #d0d0d0; }

    /* ── Responsive ── */
    @media (max-width: 768px) {
        .footer { padding: 40px 20px; }
        .footer-contact { grid-template-columns: 1fr; padding: 20px; gap: 20px; }
    }
</style>
{% endblock %}

{% block body %}
<!-- Navbar -->
{{ include('homepage/nav.html.twig') }}

<div class="back-arrow">
    <a href="{{ path('app_about') }}#about">← Back to About</a>
</div>

<div class="team-section" id="team">
    <h2 class="team-title">Meet Our Team</h2>
    <p class="team-subtitle">The minds behind the movement.</p>

    <div class="team-grid">
        <div class="team-member">
            <div class="team-photo">
                <img src="{{ asset('about/ceo.png') }}" alt="Richel"/>
            </div>
            <div class="team-info">
                <div class="team-name">Richel</div>
                <div class="team-role">CEO & Founder</div>
            </div>
        </div>

        <div class="team-member">
            <div class="team-photo">
                <img src="{{ asset('about/secretary.png') }}" alt="Chen"/>
            </div>
            <div class="team-info">
                <div class="team-name">Chen</div>
                <div class="team-role">Lead Operations</div>
            </div>
        </div>

        <div class="team-member">
            <div class="team-photo">
                <img src="{{ asset('about/designer.png') }}" alt="Sab"/>
            </div>
            <div class="team-info">
                <div class="team-name">Sab</div>
                <div class="team-role">Creative Designer</div>
            </div>
        </div>

        <div class="team-member">
            <div class="team-photo">
                <img src="{{ asset('about/rider.png') }}" alt="Nix"/>
            </div>
            <div class="team-info">
                <div class="team-name">Nix</div>
                <div class="team-role">Logistics Specialist</div>
            </div>
        </div>
    </div>
</div>

<!-- Footer -->
{{ include('homepage/footer.html.twig') }}
{% endblock %}